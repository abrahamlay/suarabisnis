# =============================================================================
# SuaraBisnis — Environment variables
# =============================================================================

# Database
DATABASE_URL=file:./local.db

# Next.js
NEXT_PUBLIC_BASE_URL=https://bamboy.my.id
SESSION_SECRET=change-me-32-chars-min-random-string-xxxxx

# Billing
# Midtrans (live keys, sandbox toggle)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email (Phase 6.7 - optional)
RESEND_API_KEY=

# =============================================================================
# Firebase Cloud Messaging (Push Notification) — Phase 6
# Get credentials from https://console.firebase.google.com/
# Free tier = Spark plan (no credit card needed)
# =============================================================================

# From: Project Settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bizbuzz-63267.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bizbuzz-63267
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bizbuzz-63267.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# From: Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# From: Project Settings → Service Accounts → Generate new private key
# IMPORTANT: Keep the literal \n characters in the private key (will be replaced at runtime)
FIREBASE_PROJECT_ID=bizbuzz-63267
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
